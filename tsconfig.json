{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@materin/ai": ["packages/ai/src/index.ts"],
      "@materin/core": ["packages/core/src/index.ts"],
      "@materin/server": ["packages/server/src/app.ts"],
      "@materin/sdk": ["packages/sdk/src/client.ts"],
      "@materin/gateway": ["packages/gateway/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "extensions/examples/**/*.ts"]
}
